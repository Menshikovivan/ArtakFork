let fs = require('fs');
let active = require('subscription.amnezia_active');
function expect(v, msg) { if (!v) die('FAIL: ' + msg + '\n'); }
let dir = ARGV[0];
let identity = 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';
let revision = 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb';
let changed = 'cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc';
let entries = [{ index: 0, name: 'afawg_a1', table: '10001', priority: '1000', private_key: 'DO_NOT_STORE' }];
let live = true, checks = 0;
let verify = function(entry) { checks++; return live && entry.name == 'afawg_a1'; };
expect(active.save(dir, 'rule_1', identity, revision, entries, verify), 'verified mapping was not saved');
let old = fs.readfile(dir + '/rule_1.json');
expect(index(old, 'DO_NOT_STORE') < 0, 'secret was serialized');
let restored = active.restore(dir, 'rule_1', identity, revision, verify);
expect(length(restored) == 1 && restored[0].name == 'afawg_a1' && checks == 2, 'restart restore did not reverify');
expect(active.restore(dir, 'rule_1', identity, changed, verify) == null, 'changed candidate revision accepted');
expect(active.restore(dir, 'rule_1', changed, revision, verify) == null, 'changed source identity accepted');
live = false;
expect(active.restore(dir, 'rule_1', identity, revision, verify) == null, 'down interface restored');
expect(!active.save(dir, 'rule_1', identity, revision, entries, verify), 'down interface saved');
expect(fs.readfile(dir + '/rule_1.json') == old, 'failed verification overwrote last mapping');
expect(active.restore(dir, 'rule_1', identity, revision, null) == null, 'mapping restored without verification');
let thrown = function(e) { die('not displayed'); };
expect(active.restore(dir, 'rule_1', identity, revision, thrown) == null, 'failed verifier accepted');
live = true;
let conflict = [entries[0], { index: 1, name: 'afawg_a2', table: '10002', priority: '1001' }];
expect(!active.save(dir, 'rule_1', identity, revision, conflict, verify), 'overlapping route priority accepted');
expect(!active.save(dir, '../bad', identity, revision, entries, verify), 'invalid source path accepted');
print('AWG active mapping, verified restart and stale-state rejection checks passed\n');
